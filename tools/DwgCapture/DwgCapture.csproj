<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DwgCapture</AssemblyName>
    <RootNamespace>DwgCapture</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- 无头 Avalonia：不弹窗口，但走真实 Skia 渲染管线。 -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DrawingView\DrawingView.csproj" />
  </ItemGroup>

</Project>
